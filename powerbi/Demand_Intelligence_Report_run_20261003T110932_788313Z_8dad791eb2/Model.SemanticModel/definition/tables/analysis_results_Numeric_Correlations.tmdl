table 'analysis_results_Numeric_Correlations'
    column 'table'
        dataType: string
        sourceColumn: "table"
        summarizeBy: none

    column 'column_a'
        dataType: string
        sourceColumn: "column_a"
        summarizeBy: none

    column 'column_b'
        dataType: string
        sourceColumn: "column_b"
        summarizeBy: none

    column 'pearson_correlation'
        dataType: double
        sourceColumn: "pearson_correlation"
        summarizeBy: sum

    partition 'analysis_results_Numeric_Correlations_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/analysis_results.xlsx"), null, true),
                SheetData = Source{[Item="Numeric_Correlations",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"table", type text},
                        {"column_a", type text},
                        {"column_b", type text},
                        {"pearson_correlation", type number}
                    }
                )
            in
                TypedColumns
