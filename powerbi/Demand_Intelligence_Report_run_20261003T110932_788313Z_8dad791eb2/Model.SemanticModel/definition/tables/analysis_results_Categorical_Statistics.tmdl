table 'analysis_results_Categorical_Statistics'
    column 'table'
        dataType: string
        sourceColumn: "table"
        summarizeBy: none

    column 'column'
        dataType: string
        sourceColumn: "column"
        summarizeBy: none

    column 'structural_type'
        dataType: string
        sourceColumn: "structural_type"
        summarizeBy: none

    column 'non_null_count'
        dataType: int64
        sourceColumn: "non_null_count"
        summarizeBy: sum

    column 'unique_count'
        dataType: int64
        sourceColumn: "unique_count"
        summarizeBy: sum

    column 'top_value'
        dataType: string
        sourceColumn: "top_value"
        summarizeBy: none

    column 'top_value_count'
        dataType: int64
        sourceColumn: "top_value_count"
        summarizeBy: sum

    column 'top_value_ratio'
        dataType: double
        sourceColumn: "top_value_ratio"
        summarizeBy: sum

    partition 'analysis_results_Categorical_Statistics_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/analysis_results.xlsx"), null, true),
                SheetData = Source{[Item="Categorical_Statistics",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"table", type text},
                        {"column", type text},
                        {"structural_type", type text},
                        {"non_null_count", Int64.Type},
                        {"unique_count", Int64.Type},
                        {"top_value", type text},
                        {"top_value_count", Int64.Type},
                        {"top_value_ratio", type number}
                    }
                )
            in
                TypedColumns
