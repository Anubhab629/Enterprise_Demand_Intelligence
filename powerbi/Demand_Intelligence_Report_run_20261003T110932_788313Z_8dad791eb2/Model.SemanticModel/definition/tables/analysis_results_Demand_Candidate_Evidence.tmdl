table 'analysis_results_Demand_Candidate_Evidence'
    column 'table'
        dataType: string
        sourceColumn: "table"
        summarizeBy: none

    column 'time_column'
        dataType: string
        sourceColumn: "time_column"
        summarizeBy: none

    column 'measure_column'
        dataType: string
        sourceColumn: "measure_column"
        summarizeBy: none

    column 'observation_count'
        dataType: int64
        sourceColumn: "observation_count"
        summarizeBy: sum

    column 'distinct_time_periods'
        dataType: int64
        sourceColumn: "distinct_time_periods"
        summarizeBy: sum

    column 'temporal_coverage'
        dataType: int64
        sourceColumn: "temporal_coverage"
        summarizeBy: sum

    column 'unique_value_count'
        dataType: int64
        sourceColumn: "unique_value_count"
        summarizeBy: sum

    column 'value_std'
        dataType: double
        sourceColumn: "value_std"
        summarizeBy: sum

    column 'candidate_score'
        dataType: double
        sourceColumn: "candidate_score"
        summarizeBy: sum

    column 'evidence_type'
        dataType: string
        sourceColumn: "evidence_type"
        summarizeBy: none

    partition 'analysis_results_Demand_Candidate_Evidence_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/analysis_results.xlsx"), null, true),
                SheetData = Source{[Item="Demand_Candidate_Evidence",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"table", type text},
                        {"time_column", type text},
                        {"measure_column", type text},
                        {"observation_count", Int64.Type},
                        {"distinct_time_periods", Int64.Type},
                        {"temporal_coverage", Int64.Type},
                        {"unique_value_count", Int64.Type},
                        {"value_std", type number},
                        {"candidate_score", type number},
                        {"evidence_type", type text}
                    }
                )
            in
                TypedColumns
    measure 'Demand Candidate Count' = COUNTROWS('analysis_results_Demand_Candidate_Evidence')
        formatString: #,##0
    measure 'Average Candidate Score' = AVERAGE('analysis_results_Demand_Candidate_Evidence'[candidate_score])
        formatString: 0.00

