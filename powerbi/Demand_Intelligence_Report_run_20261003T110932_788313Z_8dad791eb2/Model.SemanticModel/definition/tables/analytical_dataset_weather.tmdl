    partition 'analytical_dataset_weather_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/analytical_dataset.xlsx"), null, true),
                SheetData = Source{[Item="weather",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"company_id", type text},
                        {"date", type text},
                        {"temperature_c", type number},
                        {"humidity_pct", type number},
                        {"rainfall_mm", type number},
                        {"cyclone_flag", Int64.Type},
                        {"snowfall_flag", Int64.Type},
                        {"heatwave_flag", Int64.Type},
                        {"date__year", Int64.Type},
                        {"date__month", Int64.Type},
                        {"date__quarter", Int64.Type},
                        {"date__week", Int64.Type},
                        {"date__day_of_week", Int64.Type},
                        {"date__day_of_month", Int64.Type},
                        {"date__day_of_year", Int64.Type},
                        {"date__is_month_start", type logical},
                        {"date__is_month_end", type logical},
                        {"date__is_quarter_start", type logical},
                        {"date__is_quarter_end", type logical},
                        {"__numeric_non_null_count", Int64.Type},
                        {"__missing_value_count", Int64.Type},
                        {"__non_missing_value_count", Int64.Type},
                        {"__missing_value_ratio", Int64.Type}
                    }
                )
            in
