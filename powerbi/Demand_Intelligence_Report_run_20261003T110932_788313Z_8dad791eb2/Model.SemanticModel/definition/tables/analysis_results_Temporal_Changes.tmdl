table 'analysis_results_Temporal_Changes'
    column 'table'
        dataType: string
        sourceColumn: "table"
        summarizeBy: none

    column 'temporal_column'
        dataType: string
        sourceColumn: "temporal_column"
        summarizeBy: none

    column 'measure_column'
        dataType: string
        sourceColumn: "measure_column"
        summarizeBy: none

    column 'period'
        dataType: string
        sourceColumn: "period"
        summarizeBy: none

    column 'value'
        dataType: double
        sourceColumn: "value"
        summarizeBy: sum

    column 'absolute_change'
        dataType: double
        sourceColumn: "absolute_change"
        summarizeBy: sum

    partition 'analysis_results_Temporal_Changes_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/analysis_results.xlsx"), null, true),
                SheetData = Source{[Item="Temporal_Changes",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"table", type text},
                        {"temporal_column", type text},
                        {"measure_column", type text},
                        {"period", type text},
                        {"value", type number},
                        {"absolute_change", type number}
                    }
                )
            in
                TypedColumns
