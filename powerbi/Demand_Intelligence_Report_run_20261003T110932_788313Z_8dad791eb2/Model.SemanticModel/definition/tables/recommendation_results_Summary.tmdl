table 'recommendation_results_Summary'
    column 'metric'
        dataType: string
        sourceColumn: "metric"
        summarizeBy: none

    column 'value'
        dataType: int64
        sourceColumn: "value"
        summarizeBy: sum

    partition 'recommendation_results_Summary_Partition' = m
        mode: import
        source =
            let
                Source = Excel.Workbook(File.Contents("C:/Users/DELL/OneDrive/Desktop/Enterprise_Demand_Intelligence/powerbi/data/run_20261003T110932_788313Z_8dad791eb2/recommendation_results.xlsx"), null, true),
                SheetData = Source{[Item="Summary",Kind="Sheet"]}[Data],
                PromotedHeaders = Table.PromoteHeaders(
                    SheetData, [PromoteAllScalars=true]),
                TypedColumns = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"metric", type text},
                        {"value", Int64.Type}
                    }
                )
            in
                TypedColumns
